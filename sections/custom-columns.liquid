{{ 'component-custom-columns.css' | asset_url | stylesheet_tag }}

<div class="custom-columns-section color-{{ section.settings.color_scheme }} isolate" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="custom-columns__header title-wrapper-with-link center">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-columns__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="custom-columns__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-columns__grid">

      {%- comment -%} LEFT COLUMN {%- endcomment -%}
      <div class="custom-columns__col custom-columns__col--left">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'left' -%}
            <div class="custom-columns__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="custom-columns__icon">
                  {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', width: 20, height: 20 }}
                </div>
              {%- endif -%}
              <div class="custom-columns__text">
                {%- if block.settings.title != blank -%}
                  <h3 class="custom-columns__item-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="custom-columns__item-body rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} CENTER IMAGE {%- endcomment -%}
      <div class="custom-columns__col custom-columns__col--center">
        <div class="custom-columns__image-wrapper">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 90vw', widths: '400,600,800,1000' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'custom-columns__placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} RIGHT COLUMN {%- endcomment -%}
      <div class="custom-columns__col custom-columns__col--right">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'right' -%}
            <div class="custom-columns__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="custom-columns__icon">
                  {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', width: 20, height: 20 }}
                </div>
              {%- endif -%}
              <div class="custom-columns__text">
                {%- if block.settings.title != blank -%}
                  <h3 class="custom-columns__item-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="custom-columns__item-body rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom columns"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use the flexible grid system to create any layout. Each block can be placed in any of the columns."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "icon_text",
      "name": "Icon with text",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Icon with text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair text with an icon to focus on your chosen product, collection, or blog post</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom columns",
      "blocks": [
        { "type": "icon_text", "settings": { "column": "left" } },
        { "type": "icon_text", "settings": { "column": "left" } },
        { "type": "icon_text", "settings": { "column": "right" } },
        { "type": "icon_text", "settings": { "column": "right" } }
      ]
    }
  ]
}
{% endschema %}
