{% comment %}
  Hero Banner Slider
  ------------------
  A full-width homepage hero slider: each slide is a background image
  with an overlaid eyebrow / heading / subheading / button, crossfading
  between slides with a staggered text reveal (same timing system as
  the Product Slider Showcase section).

  HOW TO INSTALL:
  1. Shopify Admin → Online Store → Themes → Edit code
  2. Sections → Add a new section → name it "hero-slider"
  3. Paste this whole file in, Save
  4. Go to your theme customizer → Add section → pick "Hero Banner Slider"
  5. Click "Add slide" in the section settings for each product/image
     you want in the rotation — add as many as you like
{% endcomment %}

<div class="hs"
     id="hs-{{ section.id }}"
     data-autoplay="{{ section.settings.autoplay }}"
     data-autoplay-speed="{{ section.settings.autoplay_speed }}"
     data-pause-on-hover="{{ section.settings.pause_on_hover }}"
     style="
       --hs-height: {{ section.settings.slide_height }}px;
       --hs-height-mobile: {{ section.settings.slide_height_mobile }}px;
       --hs-text-anim-duration: {{ section.settings.text_animation_duration }}ms;
       --hs-text-anim-delay: {{ section.settings.text_animation_delay }}ms;
       --hs-text-anim-stagger: {{ section.settings.text_animation_stagger }}ms;
     ">

  {% assign slide_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'slide' %}
      {% assign slide_count = slide_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  <div class="hs__stage">
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        <div class="hs__slide {% if forloop.first %}is-active{% endif %}"
             data-hs-slide="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}>

          <div class="hs__bg">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1400 }} 1400w,
                  {{ block.settings.image | image_url: width: 2000 }} 2000w
                "
                sizes="100vw"
                alt="{{ block.settings.image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hs__placeholder' }}
            {% endif %}
            <div class="hs__overlay" style="--hs-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
          </div>

          <div class="hs__content hs__content--{{ block.settings.text_position }} hs__content--{{ block.settings.text_color }}">
            {% if block.settings.eyebrow != blank %}
              <p class="hs__eyebrow"{% if block.settings.text_color_custom %} style="color: {{ block.settings.text_color_custom }};"{% endif %}>{{ block.settings.eyebrow }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="hs__heading"{% if block.settings.text_color_custom %} style="color: {{ block.settings.text_color_custom }};"{% endif %}>{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.subheading != blank %}
              <p class="hs__subheading"{% if block.settings.text_color_custom %} style="color: {{ block.settings.text_color_custom }};"{% endif %}>{{ block.settings.subheading }}</p>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a
                {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}href="#"{% endif %}
                class="hs__cta"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if section.settings.show_arrows and slide_count > 1 %}
      <button type="button" class="hs__arrow hs__arrow--prev" data-hs-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="hs__arrow hs__arrow--next" data-hs-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    {% endif %}

    {% if section.settings.show_dots and slide_count > 1 %}
      <div class="hs__dots">
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <button
              type="button"
              class="hs__dot {% if forloop.first %}is-active{% endif %}"
              data-hs-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  #hs-{{ section.id }} {
    position: relative;
  }

  #hs-{{ section.id }} .hs__stage {
    position: relative;
    width: 100%;
    height: var(--hs-height, 600px);
    overflow: hidden;
  }

  #hs-{{ section.id }} .hs__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms ease, visibility 0s linear 600ms;
  }

  #hs-{{ section.id }} .hs__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 600ms ease, visibility 0s linear 0s;
    z-index: 1;
  }

  #hs-{{ section.id }} .hs__bg {
    position: absolute;
    inset: 0;
  }

  #hs-{{ section.id }} .hs__bg img,
  #hs-{{ section.id }} .hs__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #hs-{{ section.id }} .hs__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--hs-overlay-opacity, 0.3));
  }

  #hs-{{ section.id }} .hs__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 560px;
    padding: 0 64px;
  }

  #hs-{{ section.id }} .hs__content--center {
    align-items: center;
    text-align: center;
    max-width: 100%;
    margin: 0 auto;
  }

  #hs-{{ section.id }} .hs__content--right {
    margin-left: auto;
    text-align: right;
    align-items: flex-end;
  }

  #hs-{{ section.id }} .hs__content--dark .hs__eyebrow,
  #hs-{{ section.id }} .hs__content--dark .hs__heading,
  #hs-{{ section.id }} .hs__content--dark .hs__subheading {
    color: #1a1a1a;
  }

  #hs-{{ section.id }} .hs__content--dark .hs__cta {
    background: #1a1a1a;
    color: #fff;
  }

  #hs-{{ section.id }} .hs__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 12px;
  }

  #hs-{{ section.id }} .hs__heading {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    font-weight: 600;
    color: #fff;
    margin: 0 0 14px;
  }

  #hs-{{ section.id }} .hs__subheading {
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 28px;
  }

  #hs-{{ section.id }} .hs__cta {
    display: inline-block;
    padding: 14px 32px;
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: 2px;
    transition: opacity 0.2s ease;
    align-self: flex-start;
  }

  #hs-{{ section.id }} .hs__content--center .hs__cta,
  #hs-{{ section.id }} .hs__content--right .hs__cta {
    align-self: center;
  }

  #hs-{{ section.id }} .hs__cta:hover {
    opacity: 0.85;
  }

  /* Staggered per-line reveal, matching the Product Slider Showcase
     timing system: each line fades/rises in with an increasing delay
     once its slide becomes active, instead of the whole block
     appearing at once. */
  #hs-{{ section.id }} .hs__eyebrow,
  #hs-{{ section.id }} .hs__heading,
  #hs-{{ section.id }} .hs__subheading,
  #hs-{{ section.id }} .hs__cta {
    opacity: 0;
  }

  #hs-{{ section.id }} .hs__slide.is-active .hs__eyebrow {
    animation: hs-text-in var(--hs-text-anim-duration, 450ms) cubic-bezier(0.16, 1, 0.3, 1)
      var(--hs-text-anim-delay, 100ms) both;
  }

  #hs-{{ section.id }} .hs__slide.is-active .hs__heading {
    animation: hs-text-in var(--hs-text-anim-duration, 450ms) cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--hs-text-anim-delay, 100ms) + var(--hs-text-anim-stagger, 80ms)) both;
  }

  #hs-{{ section.id }} .hs__slide.is-active .hs__subheading {
    animation: hs-text-in var(--hs-text-anim-duration, 450ms) cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--hs-text-anim-delay, 100ms) + (var(--hs-text-anim-stagger, 80ms) * 2)) both;
  }

  #hs-{{ section.id }} .hs__slide.is-active .hs__cta {
    animation: hs-text-in var(--hs-text-anim-duration, 450ms) cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--hs-text-anim-delay, 100ms) + (var(--hs-text-anim-stagger, 80ms) * 3)) both;
  }

  @keyframes hs-text-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #hs-{{ section.id }} .hs__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.2s ease;
  }

  #hs-{{ section.id }} .hs__arrow:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  #hs-{{ section.id }} .hs__arrow--prev {
    left: 24px;
  }

  #hs-{{ section.id }} .hs__arrow--next {
    right: 24px;
  }

  #hs-{{ section.id }} .hs__dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 10px;
  }

  #hs-{{ section.id }} .hs__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #hs-{{ section.id }} .hs__dot.is-active {
    background: #fff;
    transform: scale(1.25);
  }

  @media (max-width: 749px) {
    #hs-{{ section.id }} .hs__stage {
      height: var(--hs-height-mobile, 420px);
    }

    #hs-{{ section.id }} .hs__content {
      max-width: 100%;
      padding: 0 24px;
    }

    #hs-{{ section.id }} .hs__content--right,
    #hs-{{ section.id }} .hs__content--center {
      margin: 0;
    }

    #hs-{{ section.id }} .hs__arrow {
      width: 36px;
      height: 36px;
    }

    #hs-{{ section.id }} .hs__arrow--prev {
      left: 12px;
    }

    #hs-{{ section.id }} .hs__arrow--next {
      right: 12px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('hs-{{ section.id }}');
    if (!root) return;

    var slides = root.querySelectorAll('[data-hs-slide]');
    var dots   = root.querySelectorAll('[data-hs-dot]');
    var prevBtn = root.querySelector('[data-hs-prev]');
    var nextBtn = root.querySelector('[data-hs-next]');
    var total  = slides.length;

    var autoplayEnabled = root.dataset.autoplay === 'true';
    var autoplaySpeed   = parseInt(root.dataset.autoplaySpeed, 10) || 5000;
    var pauseOnHover    = root.dataset.pauseOnHover === 'true';
    var timer = null;
    var current = 0;

    function goTo(index) {
      if (total < 2) return;
      current = ((index % total) + total) % total;

      slides.forEach(function (el) {
        el.classList.toggle('is-active', el.dataset.hsSlide === String(current));
      });
      dots.forEach(function (el) {
        el.classList.toggle('is-active', el.dataset.hsDot === String(current));
      });
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAutoplay() {
      if (!autoplayEnabled || total < 2) return;
      stopAutoplay();
      timer = setInterval(next, autoplaySpeed);
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function manualGoTo(index) {
      goTo(index);
      if (autoplayEnabled) startAutoplay();
    }

    if (nextBtn) nextBtn.addEventListener('click', function () { manualGoTo(current + 1); });
    if (prevBtn) prevBtn.addEventListener('click', function () { manualGoTo(current - 1); });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        manualGoTo(parseInt(dot.dataset.hsDot, 10));
      });
    });

    if (pauseOnHover) {
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);
    }

    // swipe support
    var stage = root.querySelector('.hs__stage');
    var startX = null;

    stage.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
    }, { passive: true });

    stage.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var diff = e.changedTouches[0].clientX - startX;
      if (diff < -40) { manualGoTo(current + 1); }
      else if (diff > 40) { manualGoTo(current - 1); }
      startX = null;
    }, { passive: true });

    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Hero Banner Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-slide time",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause auto-slide on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Slide size"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height (desktop)",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "slide_height_mobile",
      "label": "Slide height (mobile)",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Text animation"
    },
    {
      "type": "range",
      "id": "text_animation_duration",
      "label": "Text animation speed",
      "info": "How long each line takes to fade in on slide change",
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "ms",
      "default": 450
    },
    {
      "type": "range",
      "id": "text_animation_delay",
      "label": "Text animation delay",
      "info": "Pause before the first line starts animating in",
      "min": 0,
      "max": 600,
      "step": 50,
      "unit": "ms",
      "default": 100
    },
    {
      "type": "range",
      "id": "text_animation_stagger",
      "label": "Text stagger",
      "info": "Gap between each line appearing (eyebrow, heading, subheading, button)",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "info": "Small label above the heading, e.g. category name"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Classic Design"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Refined Craftsmanship"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light (for dark images)" },
            { "value": "dark", "label": "Dark (for light images)" }
          ],
          "default": "light"
        },
        {
          "type": "color",
          "id": "text_color_custom",
          "label": "Custom text color",
          "info": "Optional — pick an exact color for the eyebrow/heading/subheading. Leave blank to use the Light/Dark option above."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
