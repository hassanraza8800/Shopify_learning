<script>
  (function() {
    function initFeatureAnimations() {
      const sectionEl = document.getElementById('feat-showcase-{{ section.id }}');
      if (!sectionEl) return;

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionEl.classList.add('is-animated');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px'
      });

      observer.observe(sectionEl);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFeatureAnimations);
    } else {
      initFeatureAnimations();
    }

    // Shopify Theme Editor live reload support
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.contains(document.getElementById('feat-showcase-{{ section.id }}'))) {
        initFeatureAnimations();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Feature Showcase",
  "tag": "section",
  "class": "section-feature-spotlight",
  "settings": [
    {
      "type": "header",
      "content": "Scroll Animations"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Scroll Entrance Animation",
      "options": [
        {
          "value": "split-slide",
          "label": "Split Slide (Sides In + Center Zoom)"
        },
        {
          "value": "fade-up",
          "label": "Fade Up & Float"
        },
        {
          "value": "zoom-pop",
          "label": "Zoom & Pop"
        },
        {
          "value": "flip-in",
          "label": "3D Perspective Flip"
        }
      ],
      "default": "split-slide"
    },
    {
      "type": "range",
      "id": "anim_duration",
      "min": 400,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "label": "Animation Duration",
      "default": 800
    },
    {
      "type": "header",
      "content": "Heading & Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Engineered for Excellence"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 36
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every detail is crafted to deliver the ultimate hydration experience."
    },
    {
      "type": "range",
