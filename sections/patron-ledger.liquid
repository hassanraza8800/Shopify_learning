{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #patron-ledger-{{ section.id }} {
    --pl-quote-size: {{ section.settings.quote_size | default: 32 }}px;
    --pl-author-size: {{ section.settings.author_size | default: 13 }}px;
    --pl-eyebrow-size: {{ section.settings.eyebrow_size | default: 11 }}px;
    --pl-press-size: {{ section.settings.press_size | default: 11 }}px;
    {% if section.settings.custom_bg != blank and section.settings.custom_bg != 'rgba(0,0,0,0)' %}
      background-color: {{ section.settings.custom_bg }};
    {% endif %}
    {% if section.settings.custom_text != blank and section.settings.custom_text != 'rgba(0,0,0,0)' %}
      --pl-text: {{ section.settings.custom_text }};
    {% endif %}
    {% if section.settings.custom_accent != blank and section.settings.custom_accent != 'rgba(0,0,0,0)' %}
      --pl-accent: {{ section.settings.custom_accent }};
    {% endif %}
    {% if section.settings.custom_muted != blank and section.settings.custom_muted != 'rgba(0,0,0,0)' %}
      --pl-muted: {{ section.settings.custom_muted }};
    {% endif %}
  }
{%- endstyle -%}

<section
  id="patron-ledger-{{ section.id }}"
  class="patron-ledger color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width patron-ledger__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="patron-ledger__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <blockquote class="patron-ledger__quote">
        &ldquo;{{ section.settings.quote }}&rdquo;
      </blockquote>
    {%- endif -%}

    <div class="patron-ledger__attribution">
      {%- if section.settings.author != blank -%}
        <p class="patron-ledger__author">{{ section.settings.author }}</p>
      {%- endif -%}
      {%- if section.settings.author_subtext != blank -%}
        <p class="patron-ledger__subtext">{{ section.settings.author_subtext }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 or section.settings.press_static_list != blank -%}
      <div class="patron-ledger__press-bar">
        <div class="patron-ledger__hairline"></div>
        <ul class="patron-ledger__press-list list-unstyled" role="list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank -%}
                <li class="patron-ledger__press-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="patron-ledger__press-link">{{ block.settings.title }}</a>
                  {%- else -%}
                    <span>{{ block.settings.title }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif section.settings.press_static_list != blank -%}
            {%- assign press_items = section.settings.press_static_list | split: ',' -%}
            {%- for item in press_items -%}
              <li class="patron-ledger__press-item">
                <span>{{ item | strip }}</span>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400;1,6..72,500&display=swap');

  .patron-ledger {
    --pl-font-serif: 'Newsreader', Georgia, serif;
    --pl-font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --pl-text: #ede8dd;
    --pl-muted: #a9a697;
    --pl-accent: #b08d57;
    --pl-hairline: rgba(255, 255, 255, 0.12);
    font-family: var(--pl-font-sans);
    color: var(--pl-text);
    background-color: #12140f;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .patron-ledger__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 960px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .patron-ledger__eyebrow {
    font-family: var(--pl-font-sans);
    font-size: var(--pl-eyebrow-size, 11px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pl-accent, #b08d57);
    margin: 0 0 1.75rem 0;
  }

  .patron-ledger__quote {
    font-family: var(--pl-font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--pl-quote-size, clamp(1.4rem, 3vw, 2rem));
    line-height: 1.45;
    color: var(--pl-text, #ede8dd);
    margin: 0 0 2rem 0;
    max-width: 780px;
    letter-spacing: -0.01em;
  }

  .patron-ledger__attribution {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 3.5rem;
  }

  .patron-ledger__author {
    font-family: var(--pl-font-sans);
    font-size: var(--pl-author-size, 13px);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pl-text, #ede8dd);
    margin: 0;
  }

  .patron-ledger__subtext {
    font-family: var(--pl-font-sans);
    font-size: calc(var(--pl-author-size, 13px) * 0.85);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pl-muted, #a9a697);
    opacity: 0.8;
    margin: 0;
  }

  .patron-ledger__press-bar {
    width: 100%;
    max-width: 820px;
  }

  .patron-ledger__hairline {
    width: 100%;
    height: 1px;
    background: var(--pl-hairline, rgba(255, 255, 255, 0.12));
    margin-bottom: 1.5rem;
  }

  .patron-ledger__press-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .patron-ledger__press-item {
    font-family: var(--pl-font-sans);
    font-size: var(--pl-press-size, 11px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pl-muted, #a9a697);
    display: flex;
    align-items: center;
    opacity: 0.85;
  }

  .patron-ledger__press-item:not(:last-child)::after {
    content: '•';
    margin-left: 1.75rem;
    color: var(--pl-muted, #a9a697);
    opacity: 0.5;
  }

  .patron-ledger__press-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .patron-ledger__press-link:hover {
    color: var(--pl-text, #ede8dd);
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .patron-ledger__eyebrow {
      margin-bottom: 1.25rem;
      font-size: 10px;
    }

    .patron-ledger__quote {
      font-size: clamp(1.2rem, 5.2vw, 1.55rem);
      line-height: 1.4;
      margin-bottom: 1.5rem;
    }

    .patron-ledger__attribution {
      margin-bottom: 2.25rem;
    }

    .patron-ledger__press-list {
      gap: 0.75rem 1rem;
    }

    .patron-ledger__press-item:not(:last-child)::after {
      margin-left: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Patron Ledger Testimonial",
  "tag": "section",
  "class": "section-patron-ledger",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Theme color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow folio note",
      "default": "PATRON LEDGER • FOLIO NO. 819"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Testimonial Quote",
      "default": "The one candle I've never let myself run out of. It fills the room with the quiet chill of autumn pine needles before rain."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author & location",
      "default": "— ELEANOR V., BURLINGTON VT"
    },
    {
      "type": "text",
      "id": "author_subtext",
      "label": "Author badge / subtext",
      "default": "VERIFIED ARCHIVE PATRON"
    },
    {
      "type": "text",
      "id": "press_static_list",
      "label": "Press items (comma-separated fallback)",
      "default": "VOGUE LIVING, THE WORLD OF INTERIORS, KINFOLK FORMULARY"
    },
    {
      "type": "header",
      "content": "Typography & Font Sizes"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Quote font size",
      "default": 32
    },
    {
      "type": "range",
      "id": "author_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Author font size",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size",
      "default": 11
    },
    {
      "type": "range",
      "id": "press_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Press items font size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Custom Color Overrides (Optional)"
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom background color"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Custom text color"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Custom accent / eyebrow color"
    },
    {
      "type": "color",
      "id": "custom_muted",
      "label": "Custom secondary / press color"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "press_item",
      "name": "Press publication",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Publication name",
          "default": "VOGUE LIVING"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron Ledger Testimonial",
      "blocks": [
        { "type": "press_item", "settings": { "title": "VOGUE LIVING" } },
        { "type": "press_item", "settings": { "title": "THE WORLD OF INTERIORS" } },
        { "type": "press_item", "settings": { "title": "KINFOLK FORMULARY" } }
      ]
    }
  ]
}
{% endschema %}
